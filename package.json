{
  "name": "synchronicle",
  "version": "2.0.0",
  "description": "Multi-Agent AI Novel Writing Engine - Coordinate teams of Architect, Writer, and Editor agents to craft complete novels",
  "type": "module",
  "bin": {
    "synchronicle": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "assets/**/*.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli/index.js",
    "start:web": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "novel",
    "writing",
    "llm",
    "multi-agent",
    "cli",
    "webui"
  ],
  "license": "Apache-2.0",
  "author": "one-ea",
  "repository": {
    "type": "git",
    "url": "https://github.com/one-ea/SynChronicle.git"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.16",
    "@ai-sdk/google": "^2.0.15",
    "@ai-sdk/openai": "^2.0.32",
    "ai": "^5.0.48",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^3.4.0",
    "ink": "^6.3.1",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "drizzle-kit": "^0.31.10",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
