{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["worker", "src/db/sql-core.ts", "src/platform/dao.ts", "src/db/users.ts", "src/domain/publish.ts", "src/diag/safety.ts", "src/runtime/imp/chapters.ts", "src/store/io.ts"]
}
